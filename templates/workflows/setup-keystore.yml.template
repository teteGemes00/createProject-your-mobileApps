{% raw %}
name: Setup & Generate Keystore

on:
  workflow_dispatch:
    inputs:
      key_alias:
        description: 'Key alias'
        required: true
        default: 'android_key'
      keystore_password:
        description: 'Keystore password'
        required: true
        type: password
      key_password:
        description: 'Key password (leave empty if same as keystore)'
        required: false
        type: password
      validity_days:
        description: 'Certificate validity (days)'
        required: true
        default: '10000'
      common_name:
        description: 'Common Name (CN)'
        required: true
        default: 'Android Developer'
      organization:
        description: 'Organization (O)'
        required: true
        default: 'Developer'
      organization_unit:
        description: 'Organization Unit (OU)'
        required: true
        default: 'Development'
      locality:
        description: 'Locality (L)'
        required: true
        default: 'Jakarta'
      state:
        description: 'State (S)'
        required: true
        default: 'DKI Jakarta'
      country:
        description: 'Country Code (C)'
        required: true
        default: 'ID'

jobs:
  generate-keystore:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '11'

      - name: Generate Keystore
        run: |
          mkdir -p app
          KEY_PASS="${{ github.event.inputs.key_password }}"
          if [ -z "$KEY_PASS" ]; then
            KEY_PASS="${{ github.event.inputs.keystore_password }}"
          fi

          keytool -genkey -v \
            -keystore app/release-keystore.jks \
            -keyalg RSA \
            -keysize 2048 \
            -validity ${{ github.event.inputs.validity_days }} \
            -alias "${{ github.event.inputs.key_alias }}" \
            -storepass "${{ github.event.inputs.keystore_password }}" \
            -keypass "$KEY_PASS" \
            -dname "CN=${{ github.event.inputs.common_name }},OU=${{ github.event.inputs.organization_unit }},O=${{ github.event.inputs.organization }},L=${{ github.event.inputs.locality }},S=${{ github.event.inputs.state }},C=${{ github.event.inputs.country }}"

      - name: Commit and Push Keystore
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git config --global user.name "github-actions[bot]"
          git add -f app/release-keystore.jks
          git commit -m "chore: add release keystore"
          git push https://x-access-token:${GITHUB_TOKEN}@github.com/${{ github.repository }}.git HEAD:${{ github.ref }}

      - name: Create Keystore Info
        run: |
          cat > KEYSTORE_INFO.md << 'EOF'
          # Keystore Information
          - Alias: ${{ github.event.inputs.key_alias }}
          - Validity: ${{ github.event.inputs.validity_days }} days
          - CN: ${{ github.event.inputs.common_name }}
          - O: ${{ github.event.inputs.organization }}
          - OU: ${{ github.event.inputs.organization_unit }}
          - L: ${{ github.event.inputs.locality }}
          - S: ${{ github.event.inputs.state }}
          - C: ${{ github.event.inputs.country }}
          EOF

      - name: Upload Keystore Info Artifact
        uses: actions/upload-artifact@v4
        with:
          name: keystore-info
          path: KEYSTORE_INFO.md
          retention-days: 30

      - name: Summary
        run: |
          echo "## ✅ Keystore Generated & Pushed" >> $GITHUB_STEP_SUMMARY
          echo "- File: app/release-keystore.jks (committed)" >> $GITHUB_STEP_SUMMARY
          echo "- Info: KEYSTORE_INFO.md (artifact)" >> $GITHUB_STEP_SUMMARY
{% endraw %}
