name: Setup Keystore

on:
  workflow_dispatch:
    inputs:
      keystore_base64:
        description: 'Base64 encoded keystore file'
        required: true
      keystore_password:
        description: 'Keystore password'
        required: true
        type: password
      key_alias:
        description: 'Key alias'
        required: true
      key_password:
        description: 'Key password'
        required: true
        type: password

jobs:
  setup-keystore:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Decode and setup keystore
        env:
          KEYSTORE_BASE64: ${{ github.event.inputs.keystore_base64 }}
          KEYSTORE_PASSWORD: ${{ github.event.inputs.keystore_password }}
          KEY_ALIAS: ${{ github.event.inputs.key_alias }}
          KEY_PASSWORD: ${{ github.event.inputs.key_password }}
        run: |
          echo "$KEYSTORE_BASE64" | base64 -d > keystore.jks
          echo "keystore_path=$(pwd)/keystore.jks" >> $GITHUB_ENV
          echo "keystore_password=$KEYSTORE_PASSWORD" >> $GITHUB_ENV
          echo "key_alias=$KEY_ALIAS" >> $GITHUB_ENV
          echo "key_password=$KEY_PASSWORD" >> $GITHUB_ENV

      - name: Verify keystore
        run: |
          keytool -list -v -keystore keystore.jks -storepass ${{ env.keystore_password }} -alias ${{ env.key_alias }}

      - name: Create summary
        run: |
          echo "## Keystore Setup Complete" >> $GITHUB_STEP_SUMMARY
          echo "- Keystore loaded successfully" >> $GITHUB_STEP_SUMMARY
          echo "- Key alias: ${{ env.key_alias }}" >> $GITHUB_STEP_SUMMARY
          echo "- Ready for signing" >> $GITHUB_STEP_SUMMARY
